#环境配置与本地编辑器
venv/
.venv/
.env
.env.*
!.env.example
.obsidian/
/说明.md

#Python与测试缓存
__pycache__/
*.py[cod]
.pytest_cache/
/data/v2/frozen90/validation/pytest-temp/
.coverage
.coverage.*
htmlcov/

#向量库和BM25索引可用scripts/build_knowledge_base.py重建；模型权重保留在本地
data/indices/
saves/

#历史评测压缩包保留在本地
/data/v2/frozen90/frozen90.zip
/data/v2/frozen90/frozen90_reviewed.zip

#保留第二版实验日志，其余运行日志不提交
*.log
!/data/v2/**/*.log

#第三方仓库保留在本地，只提交对应说明
experiments/external/*
!experiments/external/README.md
archive/early-experiments/experiments/external/*
!archive/early-experiments/experiments/external/README.md

#早期实验索引保留在本地
experiments/indices/transformers/
experiments/indices/fastapi/
archive/early-experiments/experiments/indices/transformers/
archive/early-experiments/experiments/indices/fastapi/

#保留离线复现需要的训练题和测试题，其余生成结果留在本地
/experiments/routing_data/outputs/*
!/experiments/routing_data/outputs/ft_qa_100.jsonl
!/experiments/routing_data/outputs/ft_qa_450_train.jsonl
!/experiments/routing_data/outputs/ft_qa_500_train.jsonl
!/experiments/routing_data/outputs/ft_qa_500_train.reviewed.jsonl
!/experiments/routing_data/outputs/ft_qa_100_implicit_search.jsonl
!/experiments/routing_data/outputs/ft_qa_40_concept_no_tool.jsonl
!/experiments/routing_data/outputs/ft_qa_train_v2.jsonl
!/experiments/routing_data/outputs/ft_qa_450_test.jsonl

#已清理的早期演示文件，避免恢复后误提交
/docs/assets/early-demo-vectorstore-待决定删除.png
