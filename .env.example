# ========================
# RepoRouter 配置文件示例
# ========================
#
# 使用方法:
# 1. 复制本文件为 .env
# 2. 填入你的 API 密钥
# 3. 启动项目
#
# 注意: .env 文件包含敏感信息，已被 .gitignore 忽略，不会上传到 GitHub

# ========================
# 【必需】LLM 配置 - DeepSeek
# ========================
# 获取方式: https://platform.deepseek.com
deepseek_api_key=sk-your-deepseek-api-key-here
deepseek_base_url=https://api.deepseek.com
# deepseek-chat 已于 2026-07 下线；现在用 deepseek-flash（V4.1 Flash），对比实验可换 deepseek-v4-pro
model_name=deepseek-flash
# V4 默认开思考模式；Agent 默认关掉（更快更便宜）
llm_thinking=False

# ========================
# 【必需】嵌入 / 重排 / 评委 - 阿里云百炼（Qwen）
# ========================
# 获取方式: https://bailian.console.aliyun.com
# 用途: 将用户查询和代码转换成高维向量进行语义搜索；LLM-as-Judge 评委
qwen_api_key=sk-your-qwen-api-key-here
qwen_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
qwen_embedding_name=qwen3.7-text-embedding
qwen_rerank_name=qwen3.7-text-rerank
judge_model=qwen3.8-max

# ========================
# 【可选】嵌入模型选择
# ========================
# 选项: "qwen" (推荐，需要 API 密钥) 或 "local" (离线，需要额外安装 sentence-transformers)
embedding_provider=qwen

# 如果选择本地模型，默认使用（支持中文）:
local_embedding_name=Qwen/Qwen3-Embedding-0.6B

# ========================
# 【可选】重排模型选择
# ========================
# 用于对搜索结果进行精排（默认不开，评测时对比）
# 选项: "qwen" 或 "local"
reranking_provider=qwen

# ========================
# 【可选】RAG 参数调优
# ========================
# 代码 / 文本切分大小与重叠（字符数），改了要重新建库
code_chunk_size=2000
code_chunk_overlap=350
text_chunk_size=1500
text_chunk_overlap=350

# 搜索结果数量
top_k=8

# ========================
# 【可选】特性开关
# ========================
# 是否启用 Query Rewriter（将口语化查询改写为检索最优形式）
# 注意: 启用会增加 API 调用次数和延迟
enable_query_rewrite_in_tool=False

# 软熔断（search_codebase）：先算 Dense top-1 距离，超过阈值则不注入检索片段
# 阈值和 embedding 模型有关，换模型后要用 scripts/eval_soft_fuse.py 重新标定
# soft_fuse_enabled=False
# soft_fuse_distance_threshold=

# ========================
# 【可选】路由：用自己微调的小模型派单
# ========================
# native = DeepSeek 原生 function calling；phase2a = 微调后的 Qwen3.5 路由模型
routing_backend=native
router_base_url=http://127.0.0.1:8080/v1
router_model=repoagent-router

# ========================
# 【可选】训练数据生成 - Gemini
# ========================
google_api_key=
data_gen_model=gemini-4-argon
# 可选：走 OpenAI 兼容中转站生成（填了就不用 google_api_key）
data_gen_base_url=
data_gen_api_key=

# ========================
# 【可选】数据存储路径
# ========================
# 换 embedding 模型后要重新建库：python scripts/build_knowledge_base.py
Chroma_persist_dir=./data/indices/src_current_20261025
bm25_persist_dir=./data/indices/src_current_20261025/bm25_index.pkl

# ========================
# 注意事项
# ========================
# 1. API 密钥保密:
#    - 不要将 .env 提交到 Git
#    - 已在 .gitignore 中配置
#
# 2. 成本控制:
#    - DeepSeek / 百炼 API 按 token 计费
#    - 网页上每道题会显示大约花了多少钱
#    - 大量测试前建议设置额度告警
#
# 3. 网络要求:
#    - 需要访问以下域名:
#      * api.deepseek.com (LLM)
#      * dashscope.aliyuncs.com (向量 / 重排 / 评委)
#      * huggingface.co (本地模型下载，可选)
